# Copy this file to .env.local for local work in Codespaces.
# On Vercel, add these same two settings under Environment Variables.
# Both values are public. NEVER put an sb_secret_ key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY